{
  "name": "@zanbug/react-native",
  "version": "2.0.0",
  "description": "Zanbug SDK for React Native and Expo — crash reporting with real screenshots, an offline queue and app start-up / screen-load performance.",
  "keywords": [
    "zanbug",
    "error-monitoring",
    "react-native",
    "expo",
    "error-tracking",
    "crash-reporting",
    "monitoring",
    "mobile"
  ],
  "license": "MIT",
  "homepage": "https://zanbug.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/zanbug/js",
    "directory": "react-native"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./mask": {
      "types": "./dist/mask.d.ts",
      "import": "./dist/mask.js",
      "require": "./dist/mask.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "mask",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@zanbug/js": "^2.0.0"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-native": ">=0.65"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "bugs": {
    "url": "https://github.com/zanbug/js/issues"
  },
  "author": "Zanbug <dev@zanbug.com>"
}
