{
  "name": "@zanbug/nestjs",
  "version": "2.0.1",
  "description": "Zanbug SDK for NestJS — exception filter and module for automatic error reporting.",
  "keywords": [
    "zanbug",
    "error-monitoring",
    "nestjs",
    "nest",
    "error-tracking",
    "monitoring",
    "exception-filter"
  ],
  "license": "MIT",
  "homepage": "https://zanbug.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/zanbug/js",
    "directory": "nestjs"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@zanbug/js": "^2.0.1",
    "@zanbug/node": "^2.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=8.0.0",
    "@nestjs/core": ">=8.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "bugs": {
    "url": "https://github.com/zanbug/js/issues"
  },
  "author": "Zanbug <dev@zanbug.com>"
}
