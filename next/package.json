{
  "name": "@zanbug/next",
  "version": "2.0.0",
  "description": "Zanbug SDK for Next.js — App and Pages router, server and client, via instrumentation.",
  "keywords": [
    "zanbug",
    "error-monitoring",
    "nextjs",
    "next",
    "react",
    "error-tracking",
    "monitoring",
    "web-vitals"
  ],
  "license": "MIT",
  "homepage": "https://zanbug.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/zanbug/js",
    "directory": "next"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@zanbug/js": "^2.0.0",
    "@zanbug/react": "^2.0.0"
  },
  "peerDependencies": {
    "next": ">=12",
    "react": ">=16.8"
  },
  "devDependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "@types/react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "bugs": {
    "url": "https://github.com/zanbug/js/issues"
  },
  "author": "Zanbug <dev@zanbug.com>"
}
